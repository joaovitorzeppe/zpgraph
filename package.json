{
  "name": "zpgraph",
  "version": "1.3.0",
  "description": "Fast, flexible TypeScript charting library — spiritual successor to dygraphs",
  "keywords": [
    "canvas",
    "chart",
    "graph",
    "timeseries",
    "visualization",
    "zpgraph",
    "dygraphs",
    "zpgraph"
  ],
  "license": "MIT",
  "author": "João Vitor Zeppe <zeppejoaovitor@gmail.com>",
  "homepage": "https://github.com/joaovitorzeppe/zpgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorzeppe/zpgraph.git"
  },
  "bugs": {
    "url": "https://github.com/joaovitorzeppe/zpgraph/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./extras/*": {
      "types": "./dist/extras/*.d.ts",
      "import": "./dist/extras/*.js",
      "default": "./dist/extras/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGES.md"
  ],
  "scripts": {
    "build": "node scripts/gen-style-text.mjs && tsdown",
    "smoke": "node scripts/smoke-node.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "typecheck": "node scripts/gen-style-text.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node scripts/gen-style-text.mjs && vitest run",
    "test:coverage": "node scripts/gen-style-text.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "dev": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:pkg && npm run smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "browserslist": [
    "defaults",
    "supports es6-module",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
