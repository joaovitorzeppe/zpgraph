{
  "name": "zpgraph",
  "version": "1.0.0",
  "description": "Fast, flexible TypeScript charting library — spiritual successor to dygraphs",
  "keywords": [
    "canvas",
    "chart",
    "graph",
    "timeseries",
    "visualization",
    "zpgraph",
    "dygraphs",
    "zpgraph"
  ],
  "license": "MIT",
  "author": "João Vitor Zeppe <zeppejoaovitor@gmail.com>",
  "homepage": "https://github.com/joaovitorzeppe/zpgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorzeppe/zpgraph.git"
  },
  "bugs": {
    "url": "https://github.com/joaovitorzeppe/zpgraph/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/zpgraph.min.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./extras/*": {
      "types": "./dist/extras/*.d.ts",
      "import": "./dist/extras/*.js",
      "require": "./dist/extras/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGES.md",
    "demos/screenshots"
  ],
  "scripts": {
    "build": "node scripts/copy-css.mjs && tsup && tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke-node.mjs",
    "typecheck": "node scripts/copy-css.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node scripts/copy-css.mjs && vitest run",
    "test:coverage": "node scripts/copy-css.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "dev": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "browserslist": [
    "defaults",
    "supports es6-module",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
